VITE_API_BASE_URL=http://localhost:8000
VITE_MAPTILER_KEY=your_maptiler_key_here
VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key={key}

# Default admin credentials pre-filled on the login form for local runs.
# The panel still authenticates against the API, so this account must exist
# in the backend. Leave unset to use the built-in defaults below.
VITE_DEFAULT_ADMIN_EMAIL=admin@arcavia.com
VITE_DEFAULT_ADMIN_PASSWORD=12345678
